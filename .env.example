# EPIMS Infrastructure Environment Template
# Copy to .env for local deployment and replace every placeholder.
# Never commit .env or put real credentials in this file.

# General environment
EPIMS_ENV=development
EPIMS_TIMEZONE=Asia/Kolkata

# MongoDB container
MONGO_IMAGE=mongo:8
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=epims-eps
MONGODB_AUTH_DATABASE=epims-eps

# MongoDB administrator
MONGODB_ROOT_USERNAME=REPLACE_WITH_ADMIN_USERNAME
MONGODB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# MongoDB application account
MONGODB_APP_USERNAME=REPLACE_WITH_APP_USERNAME
MONGODB_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Config Server
CONFIG_SERVER_HOST=epims-config-server
CONFIG_SERVER_PORT=8888

# OpenBao
OPENBAO_HOST=openbao
OPENBAO_PORT=8200

# Secret Management API
SECRET_MANAGEMENT_API_HOST=epims-secret-management-service
SECRET_MANAGEMENT_API_PORT=8080